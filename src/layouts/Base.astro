---
import theme from '../../theme.config.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  /** Site-root-relative image path, e.g. '/images/blog/nginx.jpg'. Used for social cards. */
  image?: string;
  /** 'article' for blog posts, 'website' for everything else. */
  type?: 'website' | 'article';
  /** Machine-readable topic tags. Emitted as article:tag meta — not shown to readers. */
  tags?: string[];
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  /** Optional schema.org object. Falls back to a WebSite schema when omitted. */
  jsonLd?: Record<string, unknown>;
}

const {
  title = theme.site.name,
  description = theme.site.tagline,
  image,
  type = 'website',
  tags = [],
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;

const c = theme.colors;

// Flatten colors.categories = { linux: {bg,text,chip}, ... } into CSS vars
// like --c-cat-linux-bg, --c-cat-linux-text, --c-cat-linux-chip so any
// component can style a category chip/badge without importing theme.config.js.
const categoryVars: Record<string, string> = {};
for (const [catId, catColors] of Object.entries(c.categories ?? {})) {
  for (const [key, value] of Object.entries(catColors as Record<string, string>)) {
    categoryVars[`c-cat-${catId}-${key}`] = value;
  }
}

// ---------------------------------------------------------------------------
// Canonical + social URLs
// ---------------------------------------------------------------------------
// Astro.site comes from `site` in astro.config.mjs. Astro.url.pathname already
// includes the configured base path. Trailing slashes are stripped so that the
// canonical URL matches the form used in sitemap.xml exactly.
const siteURL = Astro.site ?? new URL(`https://${theme.site.domain}`);
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalURL = new URL(pathname, siteURL).href;

const baseTrimmed = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const socialImage = new URL(image ? `${baseTrimmed}${image}` : `${baseTrimmed}/favicon.svg`, siteURL).href;

const toISO = (d?: Date | string) => (d ? new Date(d).toISOString() : undefined);

const structuredData = jsonLd ?? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: theme.site.name,
  url: siteURL.href,
  description: theme.site.tagline,
  inLanguage: 'en',
  publisher: {
    '@type': 'Organization',
    name: theme.site.name,
    url: siteURL.href,
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content={theme.site.name} />
    <meta property="og:locale" content="en_US" />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={toISO(publishedTime)} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={toISO(modifiedTime)} />
    )}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PR6JJ0FR56"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-PR6JJ0FR56');
    </script>
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <style is:global define:vars={{
      'c-primary': c.primary,
      'c-primary-dark': c.primaryDark,
      'c-primary-light': c.primaryLight,
      'c-logo': c.logo,
      'c-hero-bg': c.heroBg,
      'c-hero-text': c.heroText,
      'c-hero-accent': c.heroAccent,
      'c-bg': c.bg,
      'c-text': c.text,
      'c-muted': c.muted,
      'c-card-bg': c.cardBg,
      'c-card-border': c.cardBorder,
      'c-card-hover': c.cardHover,
      'c-sidebar-section': c.sidebarSection,
      'c-sidebar-active': c.sidebarActive,
      'c-sidebar-text': c.sidebarText,
      'c-footer-bg': c.footerBg,
      'c-footer-text': c.footerText,
      'c-border': c.border,
      'c-accent-warm': c.accentWarm,
      ...categoryVars,
    }}>
      :root { color-scheme: light; }
      * { box-sizing: border-box; }
      html, body { width: 100%; margin: 0; padding: 0; }
      html { height: 100%; }
      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        font-family: 'Poppins', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: var(--c-bg);
        color: var(--c-text);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      main { flex: 1; width: 100%; }
      a { color: inherit; }
      img { max-width: 100%; display: block; }
      h1, h2, h3, h4, h5 { font-family: 'Poppins', sans-serif; font-weight: 700; line-height: 1.25; margin: 0; }
      .container { max-width: 1280px; margin: 0 auto; padding: 0 28px; }
      ::selection { background: var(--c-primary); color: #fff; }
    </style>
  </head>
  <body>
    <Header />
    <main data-pagefind-body>
      <slot />
    </main>
    <Footer />
  </body>
</html>
