---
// =============================================================================
// EmailSignup - the newsletter box. Currently posts nowhere; wire it up to a
// free email tool in 2 minutes:
//
//   1. Create a free Brevo account: https://www.brevo.com (free plan stores up
//      to 100,000 contacts; only sending is capped at 300 emails/day, which is
//      fine for an occasional newsletter).
//   2. In Brevo: Contacts > Forms > create a "Subscription form", grab the
//      plain HTML form it gives you.
//   3. Replace FORM_ACTION_URL below with the `action` URL from that form, and
//      copy any hidden <input> fields Brevo includes into the form below.
//
// Until then this form just prevents default submit and shows a friendly
// "not connected yet" message - it won't lose real emails.
// =============================================================================
import Icon from './Icon.astro';

const FORM_ACTION_URL = 'https://9531b8b5.sibforms.com/serve/MUIFAOJCAW6BjaLAIj21I9_rJb6JBrCnKNG1rD93I-DUlNzOBeWphdH0vFm3wy9jvC1g-dB5t7YBbYYfryvsanRa-xOR6FwV1MZD8n0X6mgeFQL5HvdQQ4742k2EqEUqGaVePG31M5D9t5OEi6lui3nM9htVSTCpZCwfI6dy87KAn4PzIu_H6mc2nuYtpmvuyo8QpujicSQfPCYrlg=='; // <-- paste your Brevo (or other) form action URL here
---

<section class="signup" aria-labelledby="signup-title">
  <div class="container signup-inner" data-reveal>
    <div class="signup-copy">
      <span class="signup-icon" aria-hidden="true"><Icon name="mail" size={24} /></span>
      <h2 id="signup-title">Get new guides by email</h2>
      <p>Join the list to get new blogs as they are published. No spam.</p>
    </div>
    <form class="signup-form" novalidate data-connected={FORM_ACTION_URL ? 'true' : 'false'} action={FORM_ACTION_URL || undefined} method="post" target="_blank">
      <label for="signup-email" class="sr-only">Email address</label>
      <div class="field">
        <input id="signup-email" type="email" name="EMAIL" placeholder="you@example.com" autocomplete="email" required aria-describedby="signup-error" />
        <button type="submit" class="btn">Subscribe</button>
      </div>
      <p class="signup-error" id="signup-error" role="alert" hidden></p>
    </form>
  </div>
  <p class="signup-note" id="signup-note" hidden>
    This form is not connected to an email list yet. Add your form action URL in src/components/EmailSignup.astro.
  </p>
</section>

<style>
  .signup { padding: 80px 0 96px; border-top: 1px solid var(--c-border); }
  .signup-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: end;
  }
  .signup-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin-bottom: 24px;
    border-radius: 12px;
    background: var(--c-primary);
    color: #fff;
  }
  .signup-copy h2 { font-size: 36px; line-height: 40px; font-weight: 700; letter-spacing: -0.025em; margin-bottom: 12px; }
  .signup-copy p { margin: 0; max-width: 44ch; font-size: 18px; line-height: 28px; color: var(--c-muted); }

  .signup-form { width: 100%; }
  .field {
    display: flex;
    gap: 8px;
    padding: 8px;
    border-radius: 16px;
    border: 1px solid var(--c-border);
    background: #fff;
    box-shadow: var(--shadow-sm);
    transition: border-color var(--dur-micro) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .field:focus-within { border-color: var(--c-primary); box-shadow: var(--shadow-md); }
  .field input {
    flex: 1;
    min-width: 0;
    padding: 8px 12px;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 16px;
    line-height: 24px;
    color: var(--c-text);
  }
  .field input:focus { outline: none; }
  .field input::placeholder { color: var(--c-muted); }
  .signup-form.has-error .field { border-color: #9B2C2C; }
  .signup-error { margin: 8px 0 0; font-size: 14px; line-height: 20px; font-weight: 500; color: #9B2C2C; }
  .signup-note { max-width: 1280px; margin: 16px auto 0; padding: 0 24px; font-size: 12px; line-height: 16px; color: var(--c-muted); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  @media (max-width: 860px) {
    .signup { padding: 64px 0 80px; }
    .signup-inner { grid-template-columns: 1fr; gap: 32px; }
    .signup-copy h2 { font-size: 30px; line-height: 36px; }
  }
  @media (max-width: 420px) {
    .field { flex-direction: column; }
    .field :global(.btn) { justify-content: center; }
  }
</style>

<script>
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll<HTMLFormElement>('.signup-form').forEach((form) => {
      const input = form.querySelector<HTMLInputElement>('input[type="email"]');
      const error = form.querySelector<HTMLElement>('.signup-error');
      const showError = (msg: string) => {
        if (!error || !input) return;
        error.textContent = msg;
        error.hidden = false;
        form.classList.add('has-error');
        input.setAttribute('aria-invalid', 'true');
      };
      const clearError = () => {
        if (!error || !input) return;
        error.hidden = true;
        form.classList.remove('has-error');
        input.removeAttribute('aria-invalid');
      };
      input?.addEventListener('input', clearError);

      form.addEventListener('submit', (e) => {
        const value = input?.value.trim() ?? '';
        if (!value) {
          e.preventDefault();
          showError('Enter your email address to subscribe.');
          input?.focus();
          return;
        }
        if (!EMAIL_RE.test(value)) {
          e.preventDefault();
          showError('That email address looks incomplete. Check it reads like name@example.com.');
          input?.focus();
          return;
        }
        if (form.dataset.connected !== 'true') {
          e.preventDefault();
          const note = document.getElementById('signup-note');
          if (note) note.hidden = false;
        }
      });
    });
  });
</script>
