---
// =============================================================================
// CategoryFilter - multi-select topic chips + a live-filtered post grid.
// Used on the homepage ("Browse by what interests you") and on /blog.
//
// Categories are NOT mutually exclusive: a post can carry more than one, and
// selecting more than one chip shows every post matching ANY selected chip
// (an OR filter) - e.g. selecting "Linux" and "DevOps" shows posts tagged
// with either.
//
// Reads ?category=slug1,slug2 from the URL on load so a link like
// `/blog?category=devops` (used by the homepage topic panel) lands with that
// filter already applied.
// =============================================================================
import type { CollectionEntry } from 'astro:content';
import { categories } from '../config/categories';
import PostCard from './PostCard.astro';

export interface Props {
  posts: CollectionEntry<'blog'>[];
  /** Show only this many cards until a filter is applied or "Show more" is clicked. Omit to always show all. */
  cap?: number;
  id?: string;
}

const { posts, cap, id = 'topic-filter' } = Astro.props;
---

<div class="category-filter" id={id} data-cap={cap ?? ''}>
  <div class="chips" role="group" aria-label="Filter by topic">
    <button type="button" class="chip chip-all" data-cat="" aria-pressed="true">All topics</button>
    {categories.map((c) => (
      <button type="button" class="chip" data-cat={c.id} aria-pressed="false">
        {c.shortLabel}
      </button>
    ))}
  </div>

  <div class="grid">
    {posts.map((post) => (
      <PostCard post={post} showDate variant="row" />
    ))}
  </div>

  <div class="empty" hidden>
    <p>No posts in that topic combination yet.</p>
    <button type="button" class="btn reset">Show all topics</button>
  </div>

  {cap && posts.length > cap && (
    <div class="show-more-wrap">
      <button type="button" class="show-more">Show more</button>
    </div>
  )}
</div>

<style>
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; }
  .chip {
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid var(--c-border);
    background: #fff;
    color: var(--c-text);
    font-family: inherit;
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color var(--dur-micro) var(--ease), border-color var(--dur-micro) var(--ease), color var(--dur-micro) var(--ease), transform var(--dur) var(--ease);
  }
  .chip:hover { border-color: var(--c-primary); }
  .chip:active { transform: scale(0.96); }
  .chip[aria-pressed="true"] { background: var(--c-primary); border-color: var(--c-primary); color: #fff; }

  .grid { display: flex; flex-direction: column; }
  .grid :global(.post-card:last-of-type) { border-bottom: 1px solid var(--c-border); }
  .grid :global(.post-card.is-hidden) { display: none; }
  /* Reveal is driven by the filter here, so cards are always visible. */
  .grid :global(.post-card[data-reveal]) { opacity: 1; transform: none; filter: none; }

  .empty { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; padding: 48px 0 64px; border-top: 1px solid var(--c-border); }
  .empty[hidden] { display: none; }
  .empty p { margin: 0; font-size: 18px; line-height: 28px; color: var(--c-muted); }

  .show-more-wrap { display: flex; margin-top: 32px; }
  .show-more {
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px solid var(--c-primary);
    background: transparent;
    color: var(--c-primary);
    font-family: inherit;
    font-size: 16px;
    line-height: 24px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color var(--dur-micro) var(--ease), color var(--dur-micro) var(--ease), transform var(--dur) var(--ease);
  }
  .show-more:hover { background: var(--c-primary); color: #fff; }
  .show-more:active { transform: scale(0.98); }
  .show-more[hidden] { display: none; }
</style>

<script>
  function initCategoryFilters() {
    document.querySelectorAll<HTMLElement>('.category-filter').forEach((root) => {
      if (root.dataset.jsInit === '1') return;
      root.dataset.jsInit = '1';

      const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('.chip'));
      const cards = Array.from(root.querySelectorAll<HTMLElement>('.post-card'));
      const emptyMsg = root.querySelector<HTMLElement>('.empty');
      const resetBtn = root.querySelector<HTMLButtonElement>('.reset');
      const showMoreBtn = root.querySelector<HTMLButtonElement>('.show-more');
      const cap = root.dataset.cap ? parseInt(root.dataset.cap, 10) : 0;
      let expanded = !cap;
      let selected = new Set<string>();

      // Pre-select from ?category=a,b in the URL.
      const params = new URLSearchParams(window.location.search);
      const fromUrl = params.get('category');
      if (fromUrl) {
        fromUrl.split(',').map((s) => s.trim()).filter(Boolean).forEach((c) => selected.add(c));
        expanded = true;
      }

      function applyChipStyles() {
        chips.forEach((chip) => {
          const cat = chip.dataset.cat || '';
          const isAll = cat === '';
          const active = isAll ? selected.size === 0 : selected.has(cat);
          chip.setAttribute('aria-pressed', String(active));
        });
      }

      function render() {
        let visibleCount = 0;
        cards.forEach((card, i) => {
          const catsAttr = card.dataset.categories || '';
          const catList = catsAttr.split(',').filter(Boolean);
          const matches = selected.size === 0 || catList.some((c) => selected.has(c));
          let show = matches;
          if (show && !expanded && cap && visibleCount >= cap) show = false;
          card.classList.toggle('is-hidden', !show);
          if (show) visibleCount++;
        });
        if (emptyMsg) emptyMsg.hidden = visibleCount > 0;
        if (showMoreBtn) {
          const matchingTotal = cards.filter((c) => {
            const catList = (c.dataset.categories || '').split(',').filter(Boolean);
            return selected.size === 0 || catList.some((cc) => selected.has(cc));
          }).length;
          showMoreBtn.hidden = expanded || matchingTotal <= cap;
        }
      }

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const cat = chip.dataset.cat || '';
          if (cat === '') {
            selected.clear();
          } else if (selected.has(cat)) {
            selected.delete(cat);
          } else {
            selected.add(cat);
          }
          applyChipStyles();
          render();
        });
      });

      resetBtn?.addEventListener('click', () => {
        selected.clear();
        applyChipStyles();
        render();
      });

      showMoreBtn?.addEventListener('click', () => {
        expanded = true;
        render();
        showMoreBtn.hidden = true;
      });

      applyChipStyles();
      render();
    });
  }

  document.addEventListener('DOMContentLoaded', initCategoryFilters);
  document.addEventListener('astro:page-load', initCategoryFilters);
</script>
