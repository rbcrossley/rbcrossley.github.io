---
import { link } from '../lib/link';
export interface Props {
  items: { title: string; href: string }[];
}
const { items } = Astro.props;
---
<aside class="discover">
  <h3 class="title">Discover more</h3>
  <ul>
    {items.map((it) => (
      <li>
        <a href={link(it.href)}>
          <span>{it.title}</span>
          <span class="arrow">›</span>
        </a>
      </li>
    ))}
  </ul>
</aside>

<style>
  .discover { background: #fff; border: 1px solid var(--c-border); border-radius: 16px; padding: 16px; }
  .title { color: var(--c-text); margin: 0 0 8px; font-size: 18px; line-height: 28px; font-weight: 600; }
  .discover ul { list-style: none; padding: 0; margin: 0; }
  .discover li { border-bottom: 1px solid var(--c-border); }
  .discover li:last-child { border-bottom: 0; }
  .discover a { display: flex; align-items: center; justify-content: space-between; padding: 12px 4px; color: var(--c-text); text-decoration: none; font-size: 16px; line-height: 24px; font-weight: 500; transition: color var(--dur-micro) var(--ease), transform var(--dur) var(--ease); }
  .discover a:hover { color: var(--c-primary); transform: translateX(8px); }
  .arrow { color: var(--c-primary); font-size: 20px; }
</style>
