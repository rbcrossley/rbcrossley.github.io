---
import { link } from '../lib/link';
import Icon from './Icon.astro';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="island">
    <a href={link('/')} class="logo-wrap" aria-label="Berojgar Engineer home">
      <span class="logo-mark">BE</span>
    </a>

    <nav class="main-nav" aria-label="Main">
      {navItems.map((item) => (
        <a href={link(item.href)} class="nav-link">{item.label}</a>
      ))}
    </nav>

    <button type="button" class="icon-btn" id="searchToggle" aria-label="Search the site">
      <Icon name="search" size={20} />
    </button>
    <button type="button" class="burger" id="mobileToggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
      <span class="burger-line top"></span>
      <span class="burger-line bottom"></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
  <nav aria-label="Mobile">
    {navItems.map((item) => (
      <a href={link(item.href)} class="mobile-link" tabindex="-1">{item.label}</a>
    ))}
  </nav>
</div>

<div class="search-overlay" id="searchOverlay" hidden>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="Search">
    <div class="search-panel-head">
      <span>Search Berojgar Engineer</span>
      <button type="button" id="searchClose" class="icon-btn" aria-label="Close search"><Icon name="x" size={20} /></button>
    </div>
    <div id="search"></div>
    <p class="search-fallback" id="searchFallback" hidden>
      Search is built by Pagefind during <code>npm run build</code>, so it is not available in the dev server.
      Run <code>npm run build &amp;&amp; npm run preview</code> to try it locally.
    </p>
  </div>
</div>

<style>
  /* Floating island navigation: a detached glass pill. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    height: var(--header-h);
    padding: 24px 16px 0;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }
  .island {
    pointer-events: auto;
    width: max-content;
    max-width: 100%;
    height: 56px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.72);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    backdrop-filter: blur(16px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      0 0 0 1px rgba(31, 36, 21, 0.08),
      var(--shadow-md);
  }

  .logo-wrap { display: inline-flex; border-radius: 9999px; text-decoration: none; }
  .logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    background: var(--c-primary);
    color: #fff;
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 0.02em;
    transition: transform var(--dur) var(--ease);
  }
  .logo-wrap:hover .logo-mark { transform: rotate(-8deg) scale(1.04); }

  .main-nav { display: flex; align-items: center; gap: 4px; margin: 0 8px; }
  .nav-link {
    padding: 8px 16px;
    border-radius: 9999px;
    color: var(--c-text);
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--dur-micro) var(--ease), color var(--dur-micro) var(--ease), transform var(--dur) var(--ease);
  }
  .nav-link:hover { background: rgba(31, 36, 21, 0.06); }
  .nav-link:active { transform: scale(0.98); }
  .nav-link[aria-current='page'] { background: var(--c-primary); color: #fff; }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    border: 0;
    background: transparent;
    color: var(--c-text);
    cursor: pointer;
    transition: background-color var(--dur-micro) var(--ease), transform var(--dur) var(--ease);
  }
  .icon-btn:hover { background: rgba(31, 36, 21, 0.06); }
  .icon-btn:active { transform: scale(0.94); }

  /* Hamburger: two lines that rotate into a true X. */
  .burger {
    display: none;
    position: relative;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 9999px;
    background: transparent;
    cursor: pointer;
  }
  .burger-line {
    position: absolute;
    left: 12px;
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: var(--c-text);
    transition: transform var(--dur) var(--ease), top var(--dur) var(--ease);
  }
  .burger-line.top { top: 15px; }
  .burger-line.bottom { top: 23px; }
  .burger[aria-expanded='true'] .burger-line.top { top: 19px; transform: rotate(45deg); }
  .burger[aria-expanded='true'] .burger-line.bottom { top: 19px; transform: rotate(-45deg); }

  /* Full screen mobile menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    display: flex;
    align-items: center;
    padding: 96px 24px 48px;
    background: rgba(255, 255, 255, 0.8);
    -webkit-backdrop-filter: blur(64px);
    backdrop-filter: blur(64px);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur) var(--ease), visibility 0s linear var(--dur);
  }
  .mobile-menu.open { opacity: 1; visibility: visible; transition: opacity var(--dur) var(--ease); }
  .mobile-menu nav { display: flex; flex-direction: column; gap: 8px; }
  .mobile-link {
    color: var(--c-text);
    font-size: 36px;
    line-height: 40px;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
    padding: 8px 0;
    opacity: 0;
    transform: translateY(48px);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease), color var(--dur-micro) var(--ease);
  }
  .mobile-menu.open .mobile-link { opacity: 1; transform: none; transition-delay: calc(120ms + var(--i, 0) * 80ms); }
  .mobile-link:nth-child(2) { --i: 1; }
  .mobile-link:nth-child(3) { --i: 2; }
  .mobile-link:nth-child(4) { --i: 3; }
  .mobile-link[aria-current='page'] { color: var(--c-primary); }

  /* Search */
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-search);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 96px 16px;
    background: rgba(255, 255, 255, 0.8);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
  }
  .search-overlay[hidden] { display: none; }
  .search-panel {
    width: 100%;
    max-width: 640px;
    padding: 24px;
    border-radius: 16px;
    background: #fff;
    border: 1px solid var(--c-border);
    box-shadow: var(--shadow-lg);
  }
  .search-panel-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; font-size: 18px; line-height: 28px; font-weight: 600; color: var(--c-text); }
  .search-fallback { margin: 12px 0 0; font-size: 14px; line-height: 20px; color: var(--c-muted); }
  .search-fallback code { padding: 2px 4px; border-radius: 4px; border: 1px solid var(--c-border); }

  @media (max-width: 720px) {
    .main-nav { display: none; }
    .burger { display: inline-block; }
    .island { width: 100%; justify-content: space-between; }
    .island .icon-btn { margin-left: auto; }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // ---- Current page --------------------------------------------------------
    const path = window.location.pathname.replace(/\/+$/, '') || '/';
    document.querySelectorAll('.nav-link, .mobile-link').forEach((a) => {
      const href = (a.getAttribute('href') || '').replace(/\/+$/, '') || '/';
      const isBlogChild = href === '/blog' && path.startsWith('/blog/');
      if (href === path || isBlogChild) a.setAttribute('aria-current', 'page');
    });

    // ---- Mobile menu -----------------------------------------------------------
    const toggle = document.getElementById('mobileToggle');
    const menu = document.getElementById('mobileMenu');
    const menuLinks = menu ? menu.querySelectorAll('.mobile-link') : [];
    function setMenu(open) {
      if (!toggle || !menu) return;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.classList.toggle('open', open);
      menu.setAttribute('aria-hidden', String(!open));
      menuLinks.forEach((l) => l.setAttribute('tabindex', open ? '0' : '-1'));
      document.body.style.overflow = open ? 'hidden' : '';
    }
    toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
    menuLinks.forEach((l) => l.addEventListener('click', () => setMenu(false)));

    // ---- Search overlay (Pagefind) ---------------------------------------------
    const searchToggle = document.getElementById('searchToggle');
    const overlay = document.getElementById('searchOverlay');
    const closeBtn = document.getElementById('searchClose');
    const mount = document.getElementById('search');
    const fallback = document.getElementById('searchFallback');
    let pagefindLoaded = false;

    async function openSearch() {
      setMenu(false);
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      if (!pagefindLoaded) {
        pagefindLoaded = true;
        const base = (document.querySelector('link[rel="icon"]')?.getAttribute('href') || '/').replace(/favicon\.svg$/, '');
        const cssLink = document.createElement('link');
        cssLink.rel = 'stylesheet';
        cssLink.href = `${base}pagefind/pagefind-ui.css`;
        document.head.appendChild(cssLink);
        try {
          const mod = await import(/* @vite-ignore */ `${base}pagefind/pagefind-ui.js`);
          const PagefindUI = mod.PagefindUI || window.PagefindUI;
          new PagefindUI({ element: '#search', showSubResults: true, showImages: false });
        } catch (err) {
          if (fallback) fallback.hidden = false;
        }
      }
      const input = mount.querySelector('input');
      if (input) input.focus();
    }

    function closeSearch() {
      overlay.hidden = true;
      document.body.style.overflow = '';
      searchToggle?.focus();
    }

    searchToggle?.addEventListener('click', openSearch);
    closeBtn?.addEventListener('click', closeSearch);
    overlay?.addEventListener('click', (e) => { if (e.target === overlay) closeSearch(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (!overlay.hidden) closeSearch();
        else if (toggle?.getAttribute('aria-expanded') === 'true') { setMenu(false); toggle.focus(); }
      }
      if ((e.key === '/' || (e.key.toLowerCase() === 'k' && (e.metaKey || e.ctrlKey))) && overlay.hidden) {
        const active = document.activeElement;
        const typing = active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA');
        if (!typing) { e.preventDefault(); openSearch(); }
      }
    });
  });
</script>
