---
import { link } from '../lib/link';
import Icon from './Icon.astro';
---

<header class="site-header">
  <div class="header-inner">
    <a href={link('/')} class="logo-wrap" aria-label="Berojgar Engineer Home">
      <span class="logo-mark">BE</span>
    </a>

    <nav class="main-nav" id="mainNav">
      <a href={link('/')} class="nav-link">Home</a>
      <a href={link('/blog')} class="nav-link">Blog</a>
      <a href={link('/about')} class="nav-link">About Us</a>
      <a href={link('/contact')} class="nav-link">Contact us</a>
    </nav>

    <div class="header-actions">
      <button type="button" class="icon-btn" id="searchToggle" aria-label="Search the site">
        <Icon name="search" size={20} />
      </button>
      <button class="mobile-toggle" id="mobileToggle" aria-label="Toggle menu">
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>
</header>

<div class="search-overlay" id="searchOverlay" hidden>
  <div class="search-panel">
    <div class="search-panel-head">
      <span>Search Berojgar Engineer</span>
      <button type="button" id="searchClose" aria-label="Close search"><Icon name="x" size={20} /></button>
    </div>
    <div id="search"></div>
    <p class="search-fallback" id="searchFallback" hidden>
      Search isn't available in the dev server - it's built by Pagefind during
      <code>npm run build</code>. Run <code>npm run build &amp;&amp; npm run preview</code> to try it locally, or just check the live site.
    </p>
  </div>
</div>

<style>
  .site-header { background: var(--c-primary-light); width: 100%; position: sticky; top: 0; z-index: 50; }
  .header-inner { max-width: 1280px; margin: 0 auto; padding: 18px 28px; display: flex; align-items: center; gap: 28px; }
  .logo-wrap { display: inline-flex; align-items: center; text-decoration: none; }
  .logo-mark { display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 56px; border-radius: 6px; background: var(--c-logo); color: #fff; font-family: 'Poppins', sans-serif; font-weight: 800; font-style: italic; font-size: 30px; letter-spacing: -1px; box-shadow: 0 2px 6px rgba(15, 23, 42, 0.25); }
  .main-nav { display: flex; align-items: center; gap: 28px; flex: 1; justify-content: center; }
  .nav-link { color: #1E293B; font-weight: 600; font-size: 16px; text-decoration: none; padding: 6px 2px; transition: color 0.2s ease; position: relative; background: none; border: none; font-family: inherit; cursor: pointer; display: inline-flex; align-items: center; }
  .nav-link:hover { color: var(--c-primary-dark); }
  .nav-link.active { color: var(--c-primary-dark); }

  .header-actions { display: flex; align-items: center; gap: 10px; }
  .icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 999px; border: none; background: transparent; color: var(--c-text); cursor: pointer; transition: background 0.15s ease; }
  .icon-btn:hover { background: rgba(15, 23, 42, 0.06); }
  .mobile-toggle { display: none; background: transparent; border: 0; cursor: pointer; color: #1E293B; align-items: center; justify-content: center; }

  .search-overlay { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.55); z-index: 100; display: flex; align-items: flex-start; justify-content: center; padding: 10vh 20px; }
  .search-overlay[hidden] { display: none; }
  .search-panel { background: #fff; width: 100%; max-width: 640px; border-radius: 14px; padding: 20px; box-shadow: 0 24px 60px rgba(0,0,0,0.3); }
  .search-panel-head { display: flex; align-items: center; justify-content: space-between; font-weight: 700; margin-bottom: 14px; color: var(--c-text); }
  .search-panel-head button { background: none; border: none; cursor: pointer; color: var(--c-muted); display: flex; }
  .search-fallback { font-size: 13px; color: var(--c-muted); margin-top: 10px; line-height: 1.6; }
  .search-fallback code { background: var(--c-primary-light); padding: 1px 6px; border-radius: 4px; }

  @media (max-width: 1024px) { .main-nav { gap: 18px; } }
  @media (max-width: 860px) {
    .main-nav { position: absolute; top: 100%; left: 0; right: 0; background: var(--c-primary-light); flex-direction: column; align-items: stretch; gap: 0; padding: 12px 24px 24px; display: none; border-top: 1px solid var(--c-border); }
    .main-nav.open { display: flex; }
    .nav-link { width: 100%; padding: 12px 0; border-bottom: 1px solid var(--c-border); justify-content: space-between; }
    .mobile-toggle { display: inline-flex; }
  }
  @media (max-width: 540px) {
    .header-inner { padding: 14px 18px; gap: 12px; }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('mobileToggle');
    const nav = document.getElementById('mainNav');
    if (toggle && nav) toggle.addEventListener('click', () => nav.classList.toggle('open'));

    const path = window.location.pathname.replace(/\/+$/, '') || '/';
    document.querySelectorAll('.nav-link').forEach((a) => {
      const href = (a.getAttribute('href') || '').replace(/\/+$/, '') || '/';
      if (href === path) a.classList.add('active');
    });

    // ---- Search overlay (Pagefind) -----------------------------------------
    const searchToggle = document.getElementById('searchToggle');
    const overlay = document.getElementById('searchOverlay');
    const closeBtn = document.getElementById('searchClose');
    const mount = document.getElementById('search');
    const fallback = document.getElementById('searchFallback');
    let pagefindLoaded = false;

    async function openSearch() {
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      if (!pagefindLoaded) {
        pagefindLoaded = true;
        const base = (document.querySelector('link[rel="icon"]')?.getAttribute('href') || '/').replace(/favicon\.svg$/, '');
        const cssLink = document.createElement('link');
        cssLink.rel = 'stylesheet';
        cssLink.href = `${base}pagefind/pagefind-ui.css`;
        document.head.appendChild(cssLink);
        try {
          const mod = await import(/* @vite-ignore */ `${base}pagefind/pagefind-ui.js`);
          const PagefindUI = mod.PagefindUI || window.PagefindUI;
          new PagefindUI({ element: '#search', showSubResults: true, showImages: false });
        } catch (err) {
          if (fallback) fallback.hidden = false;
        }
      }
      const input = mount.querySelector('input');
      if (input) input.focus();
    }

    function closeSearch() {
      overlay.hidden = true;
      document.body.style.overflow = '';
    }

    searchToggle?.addEventListener('click', openSearch);
    closeBtn?.addEventListener('click', closeSearch);
    overlay?.addEventListener('click', (e) => { if (e.target === overlay) closeSearch(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.hidden) closeSearch();
      if ((e.key === '/' || (e.key.toLowerCase() === 'k' && (e.metaKey || e.ctrlKey))) && overlay.hidden) {
        const active = document.activeElement;
        const typing = active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA');
        if (!typing) { e.preventDefault(); openSearch(); }
      }
    });
  });
</script>
