---
// =============================================================================
// AuthorBio - renders the author card shown at the end of every blog post.
// All content comes from src/config/author.ts. Nothing is hardcoded here.
//
// Usage:  <AuthorBio author={post.data.author} />
// =============================================================================
import { getAuthor, initialsOf } from '../config/author';
import { link } from '../lib/link';

export interface Props {
  /** Raw value from post frontmatter. Missing/unknown falls back to default. */
  author?: string;
}

const { author: authorKey } = Astro.props;
const author = getAuthor(authorKey);
const initials = initialsOf(author);
const isExternal = (href: string) => /^([a-z]+:)?\/\//i.test(href);
---

<aside class="author-bio" aria-label={`About ${author.name}`}>
  <div class="avatar">
    {author.avatar
      ? <img src={link(author.avatar)} alt={author.name} width="72" height="72" loading="lazy" />
      : <span class="initials" aria-hidden="true">{initials}</span>}
  </div>

  <div class="body">
    <p class="eyebrow">Written by</p>
    <h3 class="name">
      <a href={link('/about')}>{author.name}</a>
    </h3>
    <p class="role">{author.role}, {author.location}</p>
    <p class="blurb">{author.bioShort}</p>

    {author.links.length > 0 && (
      <ul class="links">
        {author.links.map((l) => (
          <li>
            <a
              href={link(l.href)}
              target={l.external ?? isExternal(l.href) ? '_blank' : undefined}
              rel={l.external ?? isExternal(l.href) ? 'noopener noreferrer' : undefined}
            >{l.label}</a>
          </li>
        ))}
      </ul>
    )}
  </div>
</aside>

<style>
  .author-bio {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    margin: 64px 0 0;
    padding: 24px;
    border: 1px solid var(--c-border);
    border-radius: 24px;
  }
  .avatar {
    flex: 0 0 auto;
    width: 72px;
    height: 72px;
    border-radius: 16px;
    overflow: hidden;
    background: var(--c-khaki);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .initials { color: var(--c-on-khaki); font-weight: 700; font-size: 24px; line-height: 32px; letter-spacing: -0.02em; }

  .body { min-width: 0; }
  .eyebrow { margin: 0 0 4px; font-size: 14px; line-height: 20px; font-weight: 500; color: var(--c-muted); }
  .name { font-size: 20px; line-height: 28px; margin: 0 0 4px; }
  .name a { color: var(--c-text); text-decoration: none; transition: color var(--dur-micro) var(--ease); }
  .name a:hover { color: var(--c-primary); }
  .role { margin: 0 0 12px; font-size: 14px; line-height: 20px; color: var(--c-muted); }
  .blurb { margin: 0 0 16px; max-width: 60ch; font-size: 16px; line-height: 24px; color: var(--c-text); }

  .links { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; }
  .links a {
    display: inline-block;
    padding: 4px 12px;
    border: 1px solid var(--c-border);
    border-radius: 8px;
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
    color: var(--c-primary);
    text-decoration: none;
    transition: background-color var(--dur-micro) var(--ease), border-color var(--dur-micro) var(--ease), color var(--dur-micro) var(--ease), transform var(--dur) var(--ease);
  }
  .links a:hover { background: var(--c-primary); border-color: var(--c-primary); color: #fff; }
  .links a:active { transform: scale(0.96); }

  @media (max-width: 640px) {
    .author-bio { flex-direction: column; gap: 16px; padding: 24px; margin-top: 48px; }
    .avatar { width: 64px; height: 64px; }
  }
</style>
