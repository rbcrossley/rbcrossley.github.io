---
import { link } from '../lib/link';

const mainLinks = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const legalLinks = [
  { href: '/privacy-policy', label: 'Privacy policy' },
  { href: '/terms', label: 'Terms and conditions' },
  { href: '/disclaimer', label: 'Disclaimer' },
  { href: '/ai-policy', label: 'AI use policy' },
  { href: '/affiliate-disclosure', label: 'Affiliate disclosure' },
  { href: '/cookie-policy', label: 'Cookie policy' },
];
---
<footer class="site-footer">
  <div class="container footer-top">
    <div class="brand">
      <span class="logo-mark" aria-hidden="true">BE</span>
      <p>
        My vision is to be a highly rated resource for freshers seeking to enter the IT industry.
        My mission is to solve the information asymmetry problem prevalent in IT careers in Nepal.
      </p>
    </div>
    <nav class="main-links" aria-label="Footer">
      {mainLinks.map((l) => <a href={link(l.href)}>{l.label}</a>)}
    </nav>
  </div>
  <div class="container footer-bottom">
    <p>© {new Date().getFullYear()} Berojgar Engineer</p>
    <nav class="legal" aria-label="Legal">
      {legalLinks.map((l) => <a href={link(l.href)}>{l.label}</a>)}
    </nav>
  </div>
</footer>

<style>
  .site-footer { width: 100%; margin-top: auto; background: var(--c-khaki); color: var(--c-on-khaki); }
  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 48px;
    align-items: end;
    padding-top: 64px;
    padding-bottom: 48px;
  }
  .brand { display: flex; flex-direction: column; gap: 24px; }
  .logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 9999px;
    background: var(--c-primary);
    color: #fff;
    font-size: 16px;
    line-height: 24px;
    font-weight: 700;
  }
  .brand p { margin: 0; max-width: 48ch; font-size: 18px; line-height: 28px; color: var(--c-primary-dark); }

  .main-links { display: flex; flex-wrap: wrap; gap: 8px 32px; }
  .main-links a {
    font-size: 20px;
    line-height: 28px;
    font-weight: 600;
    color: var(--c-on-khaki);
    text-decoration: none;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }
  .main-links a:hover { text-decoration: underline; }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 24px;
    padding-bottom: 32px;
    position: relative;
  }
  .footer-bottom::before { content: ''; position: absolute; top: 0; left: 24px; right: 24px; height: 1px; background: rgba(31, 36, 21, 0.2); }
  .footer-bottom p { margin: 0; font-size: 14px; line-height: 20px; color: var(--c-primary-dark); font-variant-numeric: tabular-nums; }
  .legal { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .legal a { font-size: 14px; line-height: 20px; color: var(--c-primary-dark); text-decoration: none; text-underline-offset: 4px; }
  .legal a:hover { color: var(--c-on-khaki); text-decoration: underline; }

  @media (max-width: 860px) {
    .footer-top { grid-template-columns: 1fr; gap: 32px; padding-top: 48px; padding-bottom: 32px; }
    .footer-bottom { flex-direction: column-reverse; align-items: flex-start; }
  }
</style>
