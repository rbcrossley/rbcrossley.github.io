---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { link } from '../lib/link';
---
<Base title="Page not found » Berojgar Engineer">
  <section class="nf">
    <div class="container nf-inner">
      <p class="code" aria-hidden="true">404</p>
      <div class="nf-copy">
        <h1>This page does not exist</h1>
        <p>The link may be old or the post may have moved. Try the blog, or search from the bar at the top.</p>
        <div class="nf-actions">
          <a class="btn" href={link('/blog')}>Browse the blog <Icon name="arrow-right" size={18} /></a>
          <a class="home-link" href={link('/')}>Go to the homepage</a>
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .nf { padding: 64px 0 96px; }
  .nf-inner { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 64px; align-items: center; }
  .code { margin: 0; font-size: 128px; line-height: 1; font-weight: 700; letter-spacing: -0.05em; color: var(--c-khaki); font-variant-numeric: tabular-nums; }
  .nf-copy h1 { font-size: 36px; line-height: 40px; letter-spacing: -0.025em; margin-bottom: 16px; }
  .nf-copy p { margin: 0 0 32px; max-width: 48ch; font-size: 18px; line-height: 28px; color: var(--c-muted); }
  .nf-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; }
  .home-link { color: var(--c-primary); font-weight: 600; text-decoration: none; text-underline-offset: 4px; }
  .home-link:hover { text-decoration: underline; }
  @media (max-width: 720px) {
    .nf-inner { grid-template-columns: 1fr; gap: 16px; }
    .code { font-size: 96px; }
  }
</style>
