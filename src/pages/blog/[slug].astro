---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import PostCard from '../../components/PostCard.astro';
import Icon from '../../components/Icon.astro';
import { getAuthor } from '../../config/author';
import { link } from '../../lib/link';
import theme from '../../../theme.config.js';
import { isPublished } from '../../config/hidden-posts';
import { getRelatedPosts } from '../../lib/related';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter(isPublished)
    .map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// ---------------------------------------------------------------------------
// Related Posts: the 3 published posts whose actual content is most similar
// to this one (TF-IDF over title, description, tags and body, plus a small
// boost for shared categories). See src/lib/related.ts.
// ---------------------------------------------------------------------------
const publishedPosts = (await getCollection('blog')).filter(isPublished);
const relatedPosts = getRelatedPosts(post, publishedPosts, 3);

// Resolve the frontmatter `author` value ("cst", "BerojgarEngineer", missing…)
// to the real author defined in src/config/author.ts.
const author = getAuthor(post.data.author);

// ---------------------------------------------------------------------------
// SEO: tags from frontmatter feed the structured data below and the
// article:tag meta tags in Base.astro. They are machine-readable only:
// nothing about this renders on the page.
// ---------------------------------------------------------------------------
const tags = post.data.tags ?? [];
const siteURL = Astro.site ?? new URL(`https://${theme.site.domain}`);
const baseTrimmed = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const pageURL = new URL(Astro.url.pathname.replace(/\/+$/, ''), siteURL).href;
const imageURL = post.data.image
  ? new URL(`${baseTrimmed}${post.data.image}`, siteURL).href
  : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: new Date(post.data.date).toISOString(),
  dateModified: new Date(post.data.date).toISOString(),
  inLanguage: 'en',
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageURL },
  url: pageURL,
  ...(imageURL ? { image: imageURL } : {}),
  ...(tags.length
    ? { keywords: tags.join(', '), about: tags.map((t) => ({ '@type': 'Thing', name: t })) }
    : {}),
  author: {
    '@type': 'Person',
    name: author.name,
    description: author.bioShort,
    jobTitle: author.role,
    url: new URL(`${baseTrimmed}/about`, siteURL).href,
  },
  publisher: {
    '@type': 'Organization',
    name: theme.site.name,
    url: siteURL.href,
  },
};
---
<Base
  title={`${post.data.title} » Berojgar Engineer`}
  description={post.data.description}
  image={post.data.image}
  type="article"
  tags={tags}
  publishedTime={post.data.date}
  jsonLd={jsonLd}
>
  <article class="blog-article">
    <header class="head">
      <a href={link('/blog')} class="back"><Icon name="arrow-left" size={16} /> Back to the blog</a>
      <h1>{post.data.title}</h1>
      <div class="meta">
        <a class="byline" href={link('/about')}>{author.shortName}</a>
        <time datetime={new Date(post.data.date).toISOString()}>{new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
      </div>
    </header>
    {post.data.image && (
      <figure class="hero-banner">
        <img src={link(post.data.image)} alt="" decoding="async" />
      </figure>
    )}
    <div class="content">
      <Content />
    </div>
    <AuthorBio author={post.data.author} />
  </article>

  {relatedPosts.length > 0 && (
    <section class="related-posts" aria-labelledby="related-title">
      <h2 class="related-title" id="related-title">Related posts</h2>
      <div class="related-deck">
        {relatedPosts.map((p, i) => <PostCard post={p} variant="row" showDate index={i} />)}
      </div>
    </section>
  )}
</Base>

<script>
  function initCodeCopyButtons() {
    const copyIcon =
      '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
    const checkIcon =
      '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';

    document.querySelectorAll('.content pre').forEach((pre) => {
      if (pre.querySelector('.copy-code-btn')) return;
      const code = pre.querySelector('code');
      if (!code) return;

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-code-btn';
      btn.setAttribute('aria-label', 'Copy code to clipboard');
      btn.innerHTML = `${copyIcon}<span class="copy-code-label">Copy</span>`;

      let resetTimer;
      btn.addEventListener('click', async () => {
        const text = code.innerText;
        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(text);
          } else {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            ta.remove();
          }
          btn.classList.add('copied');
          btn.innerHTML = `${checkIcon}<span class="copy-code-label">Copied</span>`;
        } catch (err) {
          btn.innerHTML = `${copyIcon}<span class="copy-code-label">Failed</span>`;
        }
        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          btn.classList.remove('copied');
          btn.innerHTML = `${copyIcon}<span class="copy-code-label">Copy</span>`;
        }, 2000);
      });

      pre.appendChild(btn);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCodeCopyButtons);
  } else {
    initCodeCopyButtons();
  }
</script>

<style>
  .blog-article { max-width: 768px; margin: 0 auto; padding: 48px 24px 64px; }
  .head { margin-bottom: 32px; }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--c-primary);
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
    text-decoration: none;
  }
  .back :global(svg) { transition: transform var(--dur) var(--ease); }
  .back:hover :global(svg) { transform: translateX(-4px); }
  .head h1 { font-size: 48px; line-height: 48px; font-weight: 700; letter-spacing: -0.03em; margin: 24px 0 16px; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: center; font-size: 14px; line-height: 20px; color: var(--c-muted); font-variant-numeric: tabular-nums; }
  .byline { color: var(--c-text); font-weight: 600; text-decoration: none; text-underline-offset: 4px; }
  .byline:hover { color: var(--c-primary); text-decoration: underline; }

  /* Cover image bleeds wider than the text column on large screens. */
  .hero-banner { margin: 0 -48px 48px; aspect-ratio: 16 / 9; border-radius: 24px; overflow: hidden; background: var(--c-khaki); box-shadow: var(--shadow-md); }
  .hero-banner img { width: 100%; height: 100%; object-fit: contain; }

  /* Article body */
  .content { font-size: 18px; line-height: 28px; }
  .content :global(h1) { font-size: 36px; line-height: 40px; font-weight: 700; letter-spacing: -0.025em; margin: 48px 0 16px; }
  .content :global(h2) { font-size: 30px; line-height: 36px; font-weight: 700; letter-spacing: -0.02em; margin: 48px 0 16px; }
  .content :global(h3) { font-size: 20px; line-height: 28px; font-weight: 600; margin: 32px 0 8px; }
  .content :global(h4) { font-size: 18px; line-height: 28px; font-weight: 600; margin: 24px 0 8px; }
  .content :global(p) { margin: 0 0 24px; }
  .content :global(ul), .content :global(ol) { margin: 0 0 24px; padding-left: 24px; }
  .content :global(ol) { list-style-type: decimal; }
  .content :global(ul) { list-style-type: disc; }
  .content :global(li) { margin-bottom: 8px; }
  .content :global(li::marker) { color: var(--c-primary); }
  .content :global(strong) { font-weight: 600; }
  .content :global(a) { color: var(--c-primary); text-decoration: underline; text-underline-offset: 4px; font-weight: 500; transition: color var(--dur-micro) var(--ease); }
  .content :global(a:hover) { color: var(--c-primary-dark); }
  .content :global(hr) { border: 0; border-top: 1px solid var(--c-border); margin: 48px 0; }
  .content :global(table) { width: 100%; border-collapse: collapse; margin: 24px 0 32px; display: block; overflow-x: auto; font-size: 16px; line-height: 24px; font-variant-numeric: tabular-nums; }
  .content :global(th), .content :global(td) { border: 1px solid var(--c-border); padding: 12px; text-align: left; min-width: 120px; vertical-align: top; }
  .content :global(th) { font-weight: 600; background: #fff; }
  .content :global(blockquote) { margin: 32px 0; padding: 16px 24px; border: 1px solid var(--c-border); border-radius: 12px; color: var(--c-text); }
  .content :global(blockquote p:last-child) { margin-bottom: 0; }
  .content :global(img), .content :global(iframe), .content :global(embed), .content :global(video) { max-width: 100%; height: auto; border-radius: 12px; }
  .content :global(:not(pre) > code) {
    padding: 2px 4px;
    border-radius: 4px;
    border: 1px solid var(--c-border);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.875em;
    word-break: break-word;
  }
  .content :global(pre) {
    position: relative;
    margin: 32px 0;
    padding: 16px !important;
    padding-right: 96px !important;
    border-radius: 12px;
    background-color: var(--c-code-bg) !important;
    font-size: 14px;
    line-height: 20px;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .content :global(pre code) { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .content :global(.copy-code-btn) {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 8px;
    font-family: 'Poppins', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    color: #e5e5e5;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 4px;
    cursor: pointer;
    transition: background-color var(--dur-micro) var(--ease), border-color var(--dur-micro) var(--ease), transform var(--dur) var(--ease);
  }
  .content :global(.copy-code-btn:hover) { background: rgba(255, 255, 255, 0.16); }
  .content :global(.copy-code-btn:active) { transform: scale(0.96); }
  .content :global(.copy-code-btn.copied) { background: var(--c-primary); border-color: var(--c-primary); color: #fff; }
  .content :global(.copy-code-btn svg) { flex-shrink: 0; }
  .content :global(h1), .content :global(h2), .content :global(h3), .content :global(h4), .content :global(h5), .content :global(h6),
  .content :global(p), .content :global(li), .content :global(blockquote), .content :global(th), .content :global(td) { overflow-wrap: break-word; }

  /* Related posts */
  .related-posts { max-width: 960px; margin: 0 auto; padding: 32px 24px 96px; }
  .related-title { font-size: 30px; line-height: 36px; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 24px; }
  .related-deck :global(.post-card:last-child) { border-bottom: 1px solid var(--c-border); }

  @media (max-width: 880px) {
    .hero-banner { margin: 0 0 32px; border-radius: 16px; }
  }
  @media (max-width: 720px) {
    .blog-article { padding: 32px 16px 48px; }
    .head h1 { font-size: 36px; line-height: 40px; }
    .content { font-size: 16px; line-height: 28px; }
    .content :global(h1) { font-size: 30px; line-height: 36px; }
    .content :global(h2) { font-size: 24px; line-height: 32px; }
    .content :global(pre) { padding-right: 56px !important; }
    .content :global(.copy-code-btn .copy-code-label) { display: none; }
    .content :global(.copy-code-btn) { padding: 4px; }
  }
</style>
