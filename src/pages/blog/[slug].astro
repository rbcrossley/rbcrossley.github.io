---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import { getAuthor } from '../../config/author';
import { link } from '../../lib/link';
import theme from '../../../theme.config.js';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((p) => p.slug !== 'pyq-loksewa')
    .map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Resolve the frontmatter `author` value ("cst", "BerojgarEngineer", missing…)
// to the real author defined in src/config/author.ts.
const author = getAuthor(post.data.author);

// ---------------------------------------------------------------------------
// SEO: tags from frontmatter feed the structured data below and the
// article:tag meta tags in Base.astro. They are machine-readable only —
// nothing about this renders on the page.
// ---------------------------------------------------------------------------
const tags = post.data.tags ?? [];
const siteURL = Astro.site ?? new URL(`https://${theme.site.domain}`);
const baseTrimmed = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const pageURL = new URL(Astro.url.pathname.replace(/\/+$/, ''), siteURL).href;
const imageURL = post.data.image
  ? new URL(`${baseTrimmed}${post.data.image}`, siteURL).href
  : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: new Date(post.data.date).toISOString(),
  dateModified: new Date(post.data.date).toISOString(),
  inLanguage: 'en',
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageURL },
  url: pageURL,
  ...(imageURL ? { image: imageURL } : {}),
  ...(tags.length
    ? { keywords: tags.join(', '), about: tags.map((t) => ({ '@type': 'Thing', name: t })) }
    : {}),
  author: {
    '@type': 'Person',
    name: author.name,
    jobTitle: author.role,
    url: new URL(`${baseTrimmed}/about`, siteURL).href,
  },
  publisher: {
    '@type': 'Organization',
    name: theme.site.name,
    url: siteURL.href,
  },
};
---
<Base
  title={`${post.data.title} » Berojgar Engineer`}
  description={post.data.description}
  image={post.data.image}
  type="article"
  tags={tags}
  publishedTime={post.data.date}
  jsonLd={jsonLd}
>
  <article class="blog-article">
    <header class="head">
      <a href={link('/blog')} class="back">← Back to Blog</a>
      <h1>{post.data.title}</h1>
      <div class="meta">
        <a class="byline" href={link('/about')}>{author.shortName}</a>
        <span>·</span>
        <time datetime={new Date(post.data.date).toISOString()}>{new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
      </div>
    </header>
    <div class="hero-banner" style={post.data.image ? `background-image: url('${post.data.image}'); background-size: contain; background-position: center; background-repeat: no-repeat;` : ''}></div>
    <div class="content">
      <Content />
    </div>
    <AuthorBio author={post.data.author} />
  </article>
</Base>

<style>
  .blog-article { max-width: 820px; margin: 0 auto; padding: 40px 28px 60px; }
  .head { margin-bottom: 24px; }
  .back { color: var(--c-primary); font-weight: 600; text-decoration: none; font-size: 14px; }
  .head h1 { font-size: 36px; margin: 14px 0 12px; line-height: 1.2; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; color: var(--c-muted); font-size: 14px; }
  .byline { color: var(--c-muted); text-decoration: none; font-weight: 600; }
  .byline:hover { color: var(--c-primary); text-decoration: underline; }
  .hero-banner { aspect-ratio: 21/9; background: linear-gradient(135deg, var(--c-primary), var(--c-primary-dark)); border-radius: 14px; margin: 12px 0 30px; }
  .content :global(h1) { font-size: 32px; font-weight: 700; margin: 30px 0 16px; color: var(--c-text); }
  .content :global(h2) { font-size: 26px; margin: 28px 0 14px; }
  .content :global(h3) { font-size: 20px; margin: 22px 0 10px; }
  .content :global(p) { line-height: 1.85; margin: 0 0 16px; font-size: 16px; }
  .content :global(ul), .content :global(ol) { margin: 0 0 18px 22px; line-height: 1.85; }
  .content :global(ol) { list-style-type: decimal; }
  .content :global(ul) { list-style-type: disc; }
  .content :global(li) { margin-bottom: 8px; }
  .content :global(a) { color: var(--c-primary); text-decoration: underline; font-weight: 500; cursor: pointer; transition: opacity 0.2s ease; }
  .content :global(a:hover) { opacity: 0.8; }
  .content :global(table) { width: 100%; border-collapse: collapse; margin: 16px 0 24px; display: block; overflow-x: auto; }
  .content :global(table) th, .content :global(table) td { border: 1px solid var(--c-border); padding: 12px; text-align: left; min-width: 120px; }
  .content :global(th) { background: var(--c-card-bg); font-weight: 600; }
  .content :global(tr:hover) { background: var(--c-card-hover); }
  .content :global(blockquote) { margin: 16px 0; padding: 12px 16px; border-left: 4px solid var(--c-primary); background: var(--c-card-bg); font-style: italic; color: var(--c-muted); }
  .content :global(img), .content :global(iframe), .content :global(embed), .content :global(video) { max-width: 100%; height: auto; }
  .content :global(pre), .content :global(code) { white-space: pre-wrap; word-break: break-word; }
  .content :global(h1), .content :global(h2), .content :global(h3), .content :global(h4), .content :global(h5), .content :global(h6),
  .content :global(p), .content :global(li), .content :global(blockquote), .content :global(th), .content :global(td) { overflow-wrap: break-word; word-break: break-word; }
  @media (max-width: 768px) {
    .blog-article { padding: 32px 18px 48px; }
    .head h1 { font-size: 28px; }
    .hero-banner { margin: 16px 0 24px; }
  }
</style>
