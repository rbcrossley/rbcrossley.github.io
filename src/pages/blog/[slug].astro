---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import { getAuthor } from '../../config/author';
import { link } from '../../lib/link';
import theme from '../../../theme.config.js';
import { isPublished } from '../../config/hidden-posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter(isPublished)
    .map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// ---------------------------------------------------------------------------
// Related Posts: the top 3 other published posts that share the most
// frontmatter `tags` with this one (tags are otherwise SEO-only and never
// rendered elsewhere - this is what they're for). Ties break by newest
// first, and posts with zero shared tags still fill remaining slots so the
// section always has content when there are enough other posts.
// ---------------------------------------------------------------------------
const currentTags = new Set(post.data.tags ?? []);
const relatedPosts = (await getCollection('blog'))
  .filter(isPublished)
  .filter((p) => p.slug !== post.slug)
  .map((p) => ({
    post: p,
    score: (p.data.tags ?? []).filter((t) => currentTags.has(t)).length,
  }))
  .sort((a, b) => b.score - a.score || +new Date(b.post.data.date) - +new Date(a.post.data.date))
  .slice(0, 3)
  .map((x) => x.post);

// Resolve the frontmatter `author` value ("cst", "BerojgarEngineer", missing…)
// to the real author defined in src/config/author.ts.
const author = getAuthor(post.data.author);

// ---------------------------------------------------------------------------
// SEO: tags from frontmatter feed the structured data below and the
// article:tag meta tags in Base.astro. They are machine-readable only:
// nothing about this renders on the page.
// ---------------------------------------------------------------------------
const tags = post.data.tags ?? [];
const siteURL = Astro.site ?? new URL(`https://${theme.site.domain}`);
const baseTrimmed = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const pageURL = new URL(Astro.url.pathname.replace(/\/+$/, ''), siteURL).href;
const imageURL = post.data.image
  ? new URL(`${baseTrimmed}${post.data.image}`, siteURL).href
  : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: new Date(post.data.date).toISOString(),
  dateModified: new Date(post.data.date).toISOString(),
  inLanguage: 'en',
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageURL },
  url: pageURL,
  ...(imageURL ? { image: imageURL } : {}),
  ...(tags.length
    ? { keywords: tags.join(', '), about: tags.map((t) => ({ '@type': 'Thing', name: t })) }
    : {}),
  author: {
    '@type': 'Person',
    name: author.name,
    description: author.bioShort,
    jobTitle: author.role,
    url: new URL(`${baseTrimmed}/about`, siteURL).href,
  },
  publisher: {
    '@type': 'Organization',
    name: theme.site.name,
    url: siteURL.href,
  },
};
---
<Base
  title={`${post.data.title} » Berojgar Engineer`}
  description={post.data.description}
  image={post.data.image}
  type="article"
  tags={tags}
  publishedTime={post.data.date}
  jsonLd={jsonLd}
>
  <article class="blog-article">
    <header class="head">
      <a href={link('/blog')} class="back">← Back to Blog</a>
      <h1>{post.data.title}</h1>
      <div class="meta">
        <a class="byline" href={link('/about')}>{author.shortName}</a>
        <span>·</span>
        <time datetime={new Date(post.data.date).toISOString()}>{new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
      </div>
    </header>
    <div class="hero-banner" style={post.data.image ? `background-image: url('${post.data.image}'); background-size: contain; background-position: center; background-repeat: no-repeat;` : ''}></div>
    <div class="content">
      <Content />
    </div>
    <AuthorBio author={post.data.author} />
  </article>

  {relatedPosts.length > 0 && (
    <section class="related-posts">
      <h2 class="related-title">Related Posts</h2>
      <div class="related-deck">
        {relatedPosts.map((p) => (
          <a href={link(`/blog/${p.slug}`)} class="related-card">
            <span
              class="related-thumb"
              style={`background-image: ${p.data.image ? `url('${p.data.image}')` : 'linear-gradient(135deg, var(--c-primary), var(--c-primary-dark))'};`}
            ></span>
            <span class="related-body">
              <span class="related-card-title">{p.data.title}</span>
              {p.data.description && <span class="related-desc">{p.data.description}</span>}
              <time datetime={new Date(p.data.date).toISOString()}>
                {new Date(p.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </span>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<script>
  function initCodeCopyButtons() {
    const copyIcon =
      '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
    const checkIcon =
      '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';

    document.querySelectorAll('.content pre').forEach((pre) => {
      if (pre.querySelector('.copy-code-btn')) return;
      const code = pre.querySelector('code');
      if (!code) return;

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-code-btn';
      btn.setAttribute('aria-label', 'Copy code to clipboard');
      btn.innerHTML = `${copyIcon}<span class="copy-code-label">Copy</span>`;

      let resetTimer;
      btn.addEventListener('click', async () => {
        const text = code.innerText;
        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(text);
          } else {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            ta.remove();
          }
          btn.classList.add('copied');
          btn.innerHTML = `${checkIcon}<span class="copy-code-label">Copied!</span>`;
        } catch (err) {
          btn.innerHTML = `${copyIcon}<span class="copy-code-label">Failed</span>`;
        }
        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          btn.classList.remove('copied');
          btn.innerHTML = `${copyIcon}<span class="copy-code-label">Copy</span>`;
        }, 2000);
      });

      pre.appendChild(btn);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCodeCopyButtons);
  } else {
    initCodeCopyButtons();
  }
</script>

<style>
  .blog-article { max-width: 820px; margin: 0 auto; padding: 40px 28px 60px; }
  .head { margin-bottom: 24px; }
  .back { color: var(--c-primary); font-weight: 600; text-decoration: none; font-size: 14px; }
  .head h1 { font-size: 36px; margin: 14px 0 12px; line-height: 1.2; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; color: var(--c-muted); font-size: 14px; }
  .byline { color: var(--c-muted); text-decoration: none; font-weight: 600; }
  .byline:hover { color: var(--c-primary); text-decoration: underline; }
  .hero-banner { aspect-ratio: 21/9; background: linear-gradient(135deg, var(--c-primary), var(--c-primary-dark)); border-radius: 14px; margin: 12px 0 30px; }

  /* Related posts: one column, stacked, matching the article's 820px width. */
  .related-posts { max-width: 820px; margin: 0 auto; padding: 0 28px 64px; }
  .related-title { font-size: 24px; font-weight: 800; margin: 0 0 18px; color: var(--c-text); }
  .related-deck { display: flex; flex-direction: column; gap: 16px; }
  .related-card {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 18px;
    background: var(--c-card-bg);
    border: 1px solid var(--c-card-border);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: var(--c-text);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }
  .related-card:hover { border-color: var(--c-primary); box-shadow: 0 8px 22px rgba(15, 23, 42, 0.08); transform: translateY(-2px); }
  .related-thumb { display: block; min-height: 120px; background-size: cover; background-position: center; background-repeat: no-repeat; }
  .related-body { display: flex; flex-direction: column; justify-content: center; gap: 6px; padding: 16px 18px 16px 0; min-width: 0; }
  .related-card-title { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 17px; line-height: 1.35; }
  .related-desc { font-size: 14px; line-height: 1.6; color: var(--c-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .related-body time { font-size: 12px; color: var(--c-muted); }
  @media (max-width: 560px) {
    .related-card { grid-template-columns: 1fr; gap: 0; }
    .related-thumb { aspect-ratio: 16 / 9; min-height: 0; }
    .related-body { padding: 16px 18px; }
  }
  .content :global(h1) { font-size: 32px; font-weight: 700; margin: 30px 0 16px; color: var(--c-text); }
  .content :global(h2) { font-size: 26px; margin: 28px 0 14px; }
  .content :global(h3) { font-size: 20px; margin: 22px 0 10px; }
  .content :global(p) { line-height: 1.85; margin: 0 0 16px; font-size: 16px; }
  .content :global(ul), .content :global(ol) { margin: 0 0 18px 22px; line-height: 1.85; }
  .content :global(ol) { list-style-type: decimal; }
  .content :global(ul) { list-style-type: disc; }
  .content :global(li) { margin-bottom: 8px; }
  .content :global(a) { color: var(--c-primary); text-decoration: underline; font-weight: 500; cursor: pointer; transition: opacity 0.2s ease; }
  .content :global(a:hover) { opacity: 0.8; }
  .content :global(table) { width: 100%; border-collapse: collapse; margin: 16px 0 24px; display: block; overflow-x: auto; }
  .content :global(table) th, .content :global(table) td { border: 1px solid var(--c-border); padding: 12px; text-align: left; min-width: 120px; }
  .content :global(th) { background: var(--c-card-bg); font-weight: 600; }
  .content :global(tr:hover) { background: var(--c-card-hover); }
  .content :global(blockquote) { margin: 16px 0; padding: 12px 16px; border-left: 4px solid var(--c-primary); background: var(--c-card-bg); font-style: italic; color: var(--c-muted); }
  .content :global(img), .content :global(iframe), .content :global(embed), .content :global(video) { max-width: 100%; height: auto; }
  .content :global(pre), .content :global(code) { white-space: pre-wrap; word-break: break-word; }
  .content :global(pre) { position: relative; padding: 16px !important; border-radius: 8px; margin: 20px 0; }
  .content :global(.copy-code-btn) {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    font-family: 'Poppins', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    color: #e1e4e8;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .content :global(.copy-code-btn:hover) { background: rgba(255, 255, 255, 0.2); }
  .content :global(.copy-code-btn:focus-visible) { outline: 2px solid var(--c-primary); outline-offset: 2px; }
  .content :global(.copy-code-btn.copied) { background: #2ea043; border-color: #2ea043; color: #fff; }
  .content :global(.copy-code-btn svg) { flex-shrink: 0; }
  @media (max-width: 480px) {
    .content :global(.copy-code-btn .copy-code-label) { display: none; }
    .content :global(.copy-code-btn) { padding: 6px; }
  }
  .content :global(h1), .content :global(h2), .content :global(h3), .content :global(h4), .content :global(h5), .content :global(h6),
  .content :global(p), .content :global(li), .content :global(blockquote), .content :global(th), .content :global(td) { overflow-wrap: break-word; word-break: break-word; }
  @media (max-width: 768px) {
    .blog-article { padding: 32px 18px 48px; }
    .head h1 { font-size: 28px; }
    .hero-banner { margin: 16px 0 24px; }
  }
</style>
