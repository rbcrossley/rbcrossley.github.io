---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import { isPublished } from '../../config/hidden-posts';

const posts = (await getCollection('blog'))
  .filter(isPublished)
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date));
---
<Base title="Blog » Berojgar Engineer" description="Read practical articles on computer science, Linux, IT careers, engineering studies, and working in Nepal's technology industry.">
  <section class="page">
    <div class="container">
      <h1 class="page-title">Latest from the Blog</h1>
      <p class="page-sub">Articles, tutorials and tips for computer science students. Filter by topic below.</p>

      <CategoryFilter posts={posts} id="blog-topic-filter" />
    </div>
  </section>
</Base>

<style>
  .page { padding: 50px 0; }
  .container { max-width: 1280px; margin: 0 auto; padding: 0 28px; }
  .page-title { font-size: 36px; font-weight: 800; text-align: center; margin-bottom: 8px; color: var(--c-text); }
  .page-sub { text-align: center; color: var(--c-muted); margin-bottom: 40px; }
</style>
