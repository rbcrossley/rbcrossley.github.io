---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import { isPublished } from '../../config/hidden-posts';

const posts = (await getCollection('blog'))
  .filter(isPublished)
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date));
---
<Base title="Blog » Berojgar Engineer" description="Read practical articles on computer science, Linux, IT careers, engineering studies, and working in Nepal's technology industry.">
  <section class="blog-page">
    <div class="container">
      <header class="blog-head">
        <h1>Latest from the blog</h1>
        <p>Articles, tutorials and tips for computer science students. Filter by topic below.</p>
      </header>

      <CategoryFilter posts={posts} id="blog-topic-filter" />
    </div>
  </section>
</Base>

<style>
  .blog-page { padding: 48px 0 96px; }
  .blog-head { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 32px; align-items: end; margin-bottom: 48px; }
  .blog-head h1 { font-size: 72px; line-height: 72px; font-weight: 700; letter-spacing: -0.04em; color: var(--c-text); }
  .blog-head p { margin: 0; max-width: 40ch; font-size: 18px; line-height: 28px; color: var(--c-muted); }
  @media (max-width: 860px) {
    .blog-head { grid-template-columns: 1fr; gap: 16px; }
    .blog-head h1 { font-size: 48px; line-height: 48px; }
  }
</style>
