---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import EmailSignup from '../components/EmailSignup.astro';
import { link } from '../lib/link';
import { isPublished } from '../config/hidden-posts';
import { pickFeatured } from '../config/featured-posts';

const allPosts = (await getCollection('blog'))
  .filter(isPublished)
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date));

const featuredPosts = pickFeatured(allPosts);
const [leadPost, ...sidePosts] = featuredPosts;
const latestPosts = allPosts.slice(0, 3);
---

<Base title="Berojgar Engineer: Linux, DevOps and IT careers in Nepal" description="Practical Linux, DevOps and Kubernetes notes plus honest IT career guidance for engineering graduates in Nepal.">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <h1>Practical IT career guidance for engineers in Nepal</h1>
        <p>
          TLDR of what you get here:
          1) Unfiltered Nepal-specific IT education and IT career advice.
          
          2) IT Officer and Computer Engineer Nepal government loksewa job preparation notices, strategies and resources.

          3) Homelab, Linux, DevOps content.
        </p>
        <a href={link('/blog')} class="btn">Read the latest posts <Icon name="arrow-right" size={18} /></a>
      </div>

    </div>
  </section>

  {leadPost && (
    <section class="featured" aria-labelledby="featured-title">
      <div class="container">
        <div class="section-head" data-reveal>
          <h2 class="section-title" id="featured-title">Featured guides</h2>
          <a class="text-link" href={link('/blog')}>See all guides <Icon name="arrow-right" size={16} /></a>
        </div>
        <div class="featured-grid">
          <PostCard post={leadPost} variant="feature" />
          {sidePosts.length > 0 && (
            <div class="featured-side">
              {sidePosts.map((post, i) => <PostCard post={post} variant="compact" index={i + 1} />)}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="latest" aria-labelledby="latest-title">
    <div class="container latest-grid">
      <div class="latest-head" data-reveal>
        <h2 class="section-title" id="latest-title">Latest articles</h2>
        <a class="text-link" href={link('/blog')}>Browse every article <Icon name="arrow-right" size={16} /></a>
      </div>
      <div class="latest-list">
        {latestPosts.map((post, i) => <PostCard post={post} variant="row" showDate index={i} />)}
      </div>
    </div>
  </section>

  <EmailSignup />
</Base>

<style>
  /* Hero: pure khaki, slides up under the floating header. */
  .hero {
    position: relative;
    margin-top: calc(var(--header-h) * -1);
    padding: calc(var(--header-h) + 80px) 0 96px;
    background: var(--c-khaki);
    color: var(--c-on-khaki);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 64px;
    align-items: end;
  }
  .hero-text { max-width: 680px; }
  .hero h1 {
    font-size: 60px;
    line-height: 60px;
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--c-on-khaki);
    margin-bottom: 24px;
  }
  .hero p {
    max-width: 56ch;
    margin: 0 0 32px;
    font-size: 18px;
    line-height: 28px;
    color: var(--c-primary-dark);
  }

  /* Topic panel overlaps the hero's bottom edge into the next section. */
  .tracks {
    position: relative;
    margin-bottom: -112px;
    padding: 24px;
    border-radius: 24px;
    background: #fff;
    box-shadow: var(--shadow-lg);
  }
  .tracks-title { font-size: 14px; line-height: 20px; font-weight: 600; color: var(--c-muted); margin: 0 0 8px 12px; }
  .tracks ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .track {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 12px;
    border-radius: 12px;
    color: var(--c-text);
    text-decoration: none;
    transition: background-color var(--dur-micro) var(--ease), transform var(--dur) var(--ease);
  }
  .track:hover { background: rgba(195, 176, 145, 0.24); }
  .track:active { transform: scale(0.98); }
  .track-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--c-primary);
    color: #fff;
  }
  .track-text { display: flex; flex-direction: column; min-width: 0; }
  .track-text strong { font-size: 16px; line-height: 24px; font-weight: 600; }
  .track-text span { font-size: 14px; line-height: 20px; color: var(--c-muted); }
  .track :global(.track-arrow) { color: var(--c-primary); transition: transform var(--dur) var(--ease); }
  .track:hover :global(.track-arrow) { transform: translateX(4px); }

  /* Section heads */
  .section-head { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 32px; }
  .section-title { font-size: 36px; line-height: 40px; font-weight: 700; letter-spacing: -0.025em; color: var(--c-text); }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--c-primary);
    font-size: 16px;
    line-height: 24px;
    font-weight: 600;
    text-decoration: none;
    text-underline-offset: 4px;
  }
  .text-link:hover { text-decoration: underline; }
  .text-link :global(svg) { transition: transform var(--dur) var(--ease); }
  .text-link:hover :global(svg) { transform: translateX(4px); }

  /* Featured: one lead story, two compact stories stacked beside it. */
  .featured { padding: 144px 0 80px; }
  .featured-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px; align-items: stretch; }
  /* Side stories spread evenly down the full height of the lead story:
     first one level with its image, last one level with its last line. */
  .featured-side { display: flex; flex-direction: column; }
  .featured-side :global(.post-card) { flex: 1 1 0; padding: 24px 0; border-radius: 0; }
  .featured-side :global(.post-card:first-child) { padding-top: 0; }
  .featured-side :global(.post-card:last-child) { padding-bottom: 0; }
  .featured-side :global(.post-card + .post-card) { border-top: 1px solid var(--c-border); }

  /* Latest: sticky intro on the left, rows on the right. */
  .latest { padding: 64px 0 96px; }
  .latest-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 64px; align-items: start; }
  .latest-head { position: sticky; top: 112px; display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .latest-head p { margin: 0; max-width: 32ch; color: var(--c-muted); }
  .latest-list :global(.post-card:last-child) { border-bottom: 1px solid var(--c-border); }

  @media (max-width: 1024px) {
    .hero-grid { grid-template-columns: 1fr; gap: 48px; }
    .tracks { margin-bottom: -96px; max-width: 560px; }
    .featured { padding-top: 144px; }
    .featured-grid { grid-template-columns: 1fr; }
    .featured-side :global(.post-card) { flex: none; }
    .latest-grid { grid-template-columns: 1fr; gap: 32px; }
    .latest-head { position: static; }
  }
  @media (max-width: 720px) {
    .hero { padding: calc(var(--header-h) + 48px) 0 64px; }
    .hero h1 { font-size: 36px; line-height: 40px; }
    .hero p { font-size: 16px; line-height: 24px; }
    .tracks { padding: 12px; border-radius: 16px; }
    .tracks-title { margin: 8px 0 8px 12px; }
    .section-title { font-size: 30px; line-height: 36px; }
    .featured { padding: 136px 0 64px; }
  }
</style>
