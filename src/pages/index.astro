---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import EmailSignup from '../components/EmailSignup.astro';
import { link } from '../lib/link';
import { isPublished } from '../config/hidden-posts';
import { pickFeatured } from '../config/featured-posts';

const allPosts = (await getCollection('blog'))
  .filter(isPublished)
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date));

const featuredPosts = pickFeatured(allPosts);
const latestPosts = allPosts.slice(0, 3);
---

<Base title="Berojgar Engineer - Linux, DevOps and IT Careers in Nepal" description="Practical Linux, DevOps and Kubernetes notes plus honest IT career guidance for engineering graduates in Nepal.">
  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner container">
      <div class="hero-text">
        <h1>Practical IT Career Guidance for Engineers in Nepal</h1>
        <p>
          Berojgar Engineer shares real experience, exam guides, technical tutorials and career
          advice to help Nepali engineering students, freshers and IT professionals make better
          career decisions.
        </p>
        <div class="hero-cta">
          <a href={link('/blog')} class="btn-primary">Read Latest Posts <Icon name="arrow-right" size={16} /></a>
        </div>
        <div class="hero-stats">
          <div class="stat"><Icon name="cap" size={20} /><div><strong>Career Guidance</strong><span>For students &amp; freshers</span></div></div>
          <div class="stat"><Icon name="landmark" size={20} /><div><strong>Government Jobs</strong><span>Loksewa, NTC, RBB &amp; more</span></div></div>
          <div class="stat"><Icon name="terminal" size={20} /><div><strong>Practical IT Skills</strong><span>Linux, DevOps, Server, etc.</span></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED GUIDES -->
  {featuredPosts.length > 0 && (
    <section class="featured">
      <div class="container">
        <div class="section-head">
          <h2 class="section-title">Featured Guides</h2>
          <a class="view-all" href={link('/blog')}>View All Guides <Icon name="arrow-right" size={14} /></a>
        </div>
        <div class="post-grid three">
          {featuredPosts.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  <!-- LATEST ARTICLES (auto) -->
  <section class="latest">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">Latest Articles</h2>
        <a class="view-all" href={link('/blog')}>View All Articles <Icon name="arrow-right" size={14} /></a>
      </div>
      <div class="post-grid three">
        {latestPosts.map((post) => <PostCard post={post} showDate />)}
      </div>
    </div>
  </section>

  <EmailSignup />
</Base>

<style>
  .hero { background: var(--c-hero-bg); color: var(--c-hero-text); padding: 72px 0; position: relative; overflow: hidden; }
  .hero::before { content: ''; position: absolute; top: -140px; right: -140px; width: 380px; height: 380px; border-radius: 50%; background: radial-gradient(circle, rgba(156,181,107,0.16), transparent 70%); }
  .hero-inner { position: relative; }
  .hero-text { max-width: 680px; }
  .hero h1 { font-size: 42px; line-height: 1.15; color: var(--c-hero-accent); font-weight: 800; margin-bottom: 20px; }
  .hero p { font-size: 16.5px; line-height: 1.75; color: #cbd5e1; max-width: 600px; }
  .hero-cta { margin-top: 26px; display: flex; gap: 14px; flex-wrap: wrap; }
  .btn-primary { display: inline-flex; align-items: center; gap: 8px; padding: 13px 26px; background: var(--c-primary); color: #fff; border-radius: 999px; font-weight: 700; text-decoration: none; transition: background 0.2s ease, transform 0.2s ease; box-shadow: 0 4px 14px rgba(75, 83, 32, 0.35); }
  .btn-primary:hover { background: var(--c-hero-accent); color: #1F2415; transform: translateY(-1px); }
  .hero-stats { display: flex; gap: 26px; margin-top: 36px; flex-wrap: wrap; }
  .stat { display: flex; align-items: center; gap: 10px; color: #e2e8f0; }
  .stat :global(svg) { color: var(--c-hero-accent); flex-shrink: 0; }
  .stat strong { display: block; font-size: 13.5px; }
  .stat span { display: block; font-size: 12px; color: #94a3b8; }

  .container { max-width: 1280px; margin: 0 auto; padding: 0 28px; }
  .section-title { font-size: 30px; font-weight: 800; color: var(--c-text); margin: 0 0 6px; }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 24px; flex-wrap: wrap; gap: 10px; }
  .section-head .section-title { margin: 0; }
  .view-all { display: inline-flex; align-items: center; gap: 6px; color: var(--c-primary-dark); font-weight: 700; font-size: 14px; text-decoration: none; }
  .view-all:hover { text-decoration: underline; }

  /* Featured / Latest grids */
  .featured, .latest { padding: 56px 0; }
  .post-grid.three { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }

  @media (max-width: 1024px) {
    .hero h1 { font-size: 34px; }
    .post-grid.three { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .hero h1 { font-size: 28px; }
  }
  @media (max-width: 640px) {
    .post-grid.three { grid-template-columns: 1fr; }
  }
</style>
