---
// Content comes from src/config/author.ts — edit it there, not here.
import Base from '../layouts/Base.astro';
import { getAuthor } from '../config/author';
import { link } from '../lib/link';

const author = getAuthor();
const contact = author.links.find((l) => l.label.toLowerCase() === 'contact');
---
<Base
  title="About Us » Berojgar Engineer"
  description={`${author.name} is an ${author.role} in Nepal. ${author.bioShort}`}
>
  <section class="page">
    <div class="container narrow">
      <h1 class="page-title">About Us</h1>

      {author.bio.map((p) => <p set:html={p} />)}

      {author.sections.map((s) => (
        <>
          <h2>{s.heading}</h2>
          {s.paragraphs.map((p) => <p set:html={p} />)}
        </>
      ))}

      {contact && (
        <p>
          If you have a question or would like to connect, please visit our{' '}
          <a href={link(contact.href)}>contact page</a>.
        </p>
      )}
    </div>
  </section>
</Base>
<style>
  .page { padding: 50px 0 60px; }
  .narrow { width: 100%; max-width: 800px; }
  .page-title { font-size: 36px; font-weight: 800; margin-bottom: 20px; color: var(--c-text); }
  h2 { font-size: 22px; margin: 26px 0 12px; color: var(--c-primary-dark); }
  p { line-height: 1.85; margin: 0 0 16px; }
  ul { margin: 0 0 16px 22px; line-height: 1.85; }
  a { color: var(--c-primary); text-decoration: underline; overflow-wrap: anywhere; }

  @media (max-width: 640px) {
    .page { padding: 32px 0 44px; }
    .page-title { font-size: 30px; }
    h2 { font-size: 20px; }
    p { line-height: 1.7; }
  }
</style>
