---
// Content comes from src/config/author.ts - edit it there, not here.
import Base from '../layouts/Base.astro';
import { getAuthor } from '../config/author';
import { link } from '../lib/link';

const author = getAuthor();
const contact = author.links.find((l) => l.label.toLowerCase() === 'contact');
---
<Base
  title="About » Berojgar Engineer"
  description={author.bioShort}
>
  <section class="page">
    <div class="container narrow">
      <h1 class="page-title">About</h1>

      {author.bio.map((p) => <p set:html={p} />)}

      {author.sections.map((s) => (
        <>
          <h2>{s.heading}</h2>
          {s.paragraphs.map((p) => <p set:html={p} />)}
        </>
      ))}

      {contact && (
        <p>
          If you have a question or would like to connect, please visit our{' '}
          <a href={link(contact.href)}>contact page</a>.
        </p>
      )}
    </div>
  </section>
</Base>
