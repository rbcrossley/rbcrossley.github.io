  "dependencies": {
    "@astrojs/mdx": "^3.1.9",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/tailwind": "^5.1.4",
    "astro": "^4.16.19",
    "astro-icon": "^1.1.5",
    "lucide-static": "^0.469.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "pagefind": "^1.3.0"
  }
}
