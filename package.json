{
  "name": "cstaleem-clone",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "start": "astro dev --host 0.0.0.0 --port 3000",
    "dev": "astro dev --host 0.0.0.0 --port 3000",
    "build": "astro build && pagefind --site dist --output-path dist/pagefind",
    "preview": "astro preview",
